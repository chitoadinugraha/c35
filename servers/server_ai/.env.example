# c35 server_ai — copy to .env.local (not committed)
# Cluster credentials load from D:\alienai_proto\cluster\.env.local first.

LISTEN=0.0.0.0:8080
# Schema applies lazily on first missing-table error (no startup migration).
C35_JWT_SECRET=dev-change-me
C35_PUBLIC_ORIGIN=https://alienai.id
CAS_HMAC_SECRET=dev-cas-hmac
CAS_DIR=.cache/cas
# CAS_STORE=disk  # dev fallback for blobs >=512 KiB (default: s3 when S3_* set)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_SECURE=1

# WebRTC TURN (coturn use-auth-secret). Leave empty for STUN-only local dev.
# C35_TURN_SECRET=
# C35_TURN_REALM=alienai.id
# C35_STUN_URLS=stun:turn.alienai.id:3479
# C35_TURN_URLS=turn:turn.alienai.id:3479?transport=udp

# Google OAuth (same client as cs_agent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API (embed + LLM catalog sync). GOOGLE_API_KEY also accepted.
GEMINI_API_KEY=

# LLM catalog sync from Gemini API (default on; set 0 to disable)
# LLM_CATALOG_SYNC=1

# YSQL — host/user/password from cluster .env.local; database forced to c35 in code
YB_HOST=yb-tservers.yugabyte.svc.cluster.local
YB_PORT=5433
YB_DATABASE=c35
YB_SSLMODE=disable

# Cluster NATS (Tailscale + cluster.local split DNS)
NATS_URL=tls://nats-client.nats.svc.cluster.local:4222
NATS_USER=csa_site
NATS_PASS=
NATS_CA=D:/cs_agent/_/certs/nats-ca.crt
