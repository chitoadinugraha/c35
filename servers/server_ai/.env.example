# c35 server_ai — copy to .env.local (not committed)
# Cluster credentials load from D:\alienai_proto\cluster\.env.local first.

LISTEN=0.0.0.0:8080
# Schema applies lazily on first missing-table error (no startup migration).
C35_JWT_SECRET=dev-change-me
C35_PUBLIC_ORIGIN=https://alienai.id
CAS_HMAC_SECRET=dev-cas-hmac
CAS_DIR=.cache/cas
# CAS_STORE=disk  # dev fallback for blobs >=512 KiB (default: s3 when S3_* set)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_SECURE=1

# WebRTC TURN (coturn use-auth-secret). Leave empty for STUN-only local dev.
# C35_TURN_SECRET=
# C35_TURN_REALM=alienai.id
# C35_STUN_URLS=stun:turn.alienai.id:3479
# C35_TURN_URLS=turn:turn.alienai.id:3479?transport=udp

# Google OAuth (same client as cs_agent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MCP agent HTTP API (Node c35 MCP — tool_exec / prompt_compose / prompt_run)
# See _/docs/mcp-security.md before enabling in production.
# Generate: openssl rand -hex 32  (release builds require >= 32 chars)
# C35_MCP_AGENT_ENABLED=1
# C35_MCP_AGENT_KEY=

# Gemini API (embed + LLM catalog sync). GOOGLE_API_KEY also accepted.
GEMINI_API_KEY=

# LLM catalog sync from Gemini API (default on; set 0 to disable)
# LLM_CATALOG_SYNC=1

# c35-fetcher (cluster singleton). When 1, server_ai skips llm_catalog_spawn.
# EXTERNAL_FETCHER=1

# Open Exchange Rates (c35-fetcher FX task). Not used by server_ai directly.
# OPENEXCHANGERATES_APP_ID=
# FX_MARKUP_BPS=1000
# FX_CHANGE_THRESHOLD_BPS=25

# YSQL — host/user/password from cluster .env.local; database forced to c35 in code
YB_HOST=yb-tservers.yugabyte.svc.cluster.local
YB_PORT=5433
YB_DATABASE=c35
YB_SSLMODE=disable

# SQLx pool (per process). Local dev: PG_MIN_CONNECTIONS=1 avoids ~30s cold connect to remote YB.
PG_MAX_CONNECTIONS=24
PG_MIN_CONNECTIONS=4
PG_TEST_BEFORE_ACQUIRE=false
PG_SLOW_STATEMENT_MS=1000
PG_SLOW_ACQUIRE_MS=3000
# Max concurrent JetStream prompt jobs per server_ai pod (default 8).
PROMPT_RUN_MAX_CONCURRENT=8
# Local dev: run WebSocket prompts in this server_ai process (same binary as MCP prompt_run).
# Without this, jobs enqueue to cluster NATS and run on deployed pods (may lag your local code).
C35_PROMPT_RUN_INLINE=1
# PG_ACQUIRE_TIMEOUT_SECS=30
# PG_IDLE_TIMEOUT_SECS=600
# PG_MAX_LIFETIME_SECS=1800

# Cluster NATS (Tailscale + cluster.local split DNS)
NATS_URL=tls://nats-client.nats.svc.cluster.local:4222
NATS_USER=csa_site
NATS_PASS=
NATS_CA=D:/cs_agent/_/certs/nats-ca.crt

# Midtrans — sandbox when MIDTRANS_IS_PRODUCTION=false (uses MIDTRANS_SANDBOX_* keys)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_USD_IDR=17630
MIDTRANS_SANDBOX_MERCHANT_ID=
MIDTRANS_SANDBOX_SERVER_KEY=
MIDTRANS_SANDBOX_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Cloudflare Workers AI Whisper (STT)
# Account ID defaults to 13bbda4c964029cb15bb16c7d57ec548 if not set.
# Token requires "Workers AI: Read/Edit" permission.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=13bbda4c964029cb15bb16c7d57ec548
# Optional: Cloudflare AI Gateway
# CLOUDFLARE_AI_GATEWAY_ID=
# CLOUDFLARE_AI_GATEWAY_URL=

