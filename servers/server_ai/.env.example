# c35 server_ai — copy to .env.local (not committed)
# Cluster credentials load from D:\alienai_proto\cluster\.env.local first.

LISTEN=0.0.0.0:8080
# Schema applies lazily on first missing-table error (no startup migration).
C35_JWT_SECRET=dev-change-me
C35_PUBLIC_ORIGIN=https://alienai.id
CAS_HMAC_SECRET=dev-cas-hmac
CAS_DIR=.cache/cas

# Google OAuth (same client as cs_agent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YSQL — host/user/password from cluster .env.local; database forced to c35 in code
YB_HOST=yb-tservers.yugabyte.svc.cluster.local
YB_PORT=5433
YB_DATABASE=c35
YB_SSLMODE=disable

# Cluster NATS (Tailscale + cluster.local split DNS)
NATS_URL=tls://nats-client.nats.svc.cluster.local:4222
NATS_USER=csa_site
NATS_PASS=
NATS_CA=D:/cs_agent/_/certs/nats-ca.crt
