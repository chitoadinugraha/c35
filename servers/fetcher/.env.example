# c35_fetcher — copy to .env.local (not committed)
# Cluster credentials load from D:\alienai_proto\cluster\.env.local first.

# YSQL — host/user/password from cluster .env.local; database forced to c35 in code
YB_HOST=yb-tservers.yugabyte.svc.cluster.local
YB_PORT=5433
YB_DATABASE=c35

# NATS (required)
NATS_URL=tls://nats-client.nats.svc.cluster.local:4222
# NATS_USER=
# NATS_PASS=
# NATS_CA=/nats-ca/ca.crt

# FX rate task (Open Exchange Rates)
OPENEXCHANGERATES_APP_ID=
FX_MARKUP_BPS=1000
FX_CHANGE_THRESHOLD_BPS=25
FX_FETCH_INTERVAL_SECS=3600

# LLM catalog task (Gemini models API)
GEMINI_API_KEY=
LLM_CATALOG_SYNC=1

# ---------------------------------------------------------------------------
# Platform vendor billing (mod_platform) — daily MTD + month-close finalize
# ---------------------------------------------------------------------------

# Shared schedule (all vendors)
VENDOR_BILL_FETCH_INTERVAL_SECS=86400
VENDOR_BILL_MTD_ENABLED=1
VENDOR_BILL_FINALIZE_DAYS=1,3,7,14
VENDOR_BILL_STAGGER_MINS=0,15,30,45
VENDOR_BILL_TZ=Asia/Jakarta

# OCI Usage API
# OCI_VENDOR_BILL_ENABLED=1
# OCI_TENANCY_OCID=
# OCI_USER_OCID=
# OCI_FINGERPRINT=
# OCI_COMPARTMENT_OCID=
# OCI_REGION=ap-southeast-1
# OCI_PRIVATE_KEY=          # PEM inline (preferred in k8s secret)
# OCI_PRIVATE_KEY_PATH=     # local dev: path to PEM file

# GCP BigQuery billing export
# GCP_VENDOR_BILL_ENABLED=1
# GCP_BILLING_PROJECT_ID=
# GCP_BILLING_DATASET=
# GCP_BILLING_TABLE=
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Cloudflare GraphQL (estimated daily) + CSV import for month-close
# CF_VENDOR_BILL_ENABLED=1
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Wasabi account billing API
# WASABI_VENDOR_BILL_ENABLED=1
# WASABI_ACCESS_KEY=
# WASABI_SECRET_KEY=
# WASABI_REGION=ap-southeast-1
