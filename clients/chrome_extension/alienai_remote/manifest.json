{
  "manifest_version": 3,
  "name": "Alien AI Remote",
  "version": "1.0.36",
  "description": "Remote control your daily Chrome profile via Alien AI (native host + WebRTC).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Alien AI Remote",
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://alienai.id/*"
    ]
  },
  "key": ""
}
